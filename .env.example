# ATRUE - simulation platform environment template.
# Copy to `.env` (already git-ignored) and fill in real values.
# NEVER commit the real .env.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False

# --- Local PostgreSQL (Section 3.2 of the requirements) ----------------------
DB_NAME=atrue_db
DB_USER=atrue_user
DB_PASSWORD=your_secure_password
DB_HOST=localhost
DB_PORT=5432

# --- Render / hosted PostgreSQL ------------------------------------------------
# When set, DATABASE_URL wins over the DB_* values above.
# DATABASE_URL=postgresql://atrue_user:password@host:5432/atrue_db

# --- Production extras --------------------------------------------------------
# Comma separated; leave empty for the default localhost pair.
# ALLOWED_HOSTS=atrue.onrender.com
# SECURE_SSL_REDIRECT=True
# CSRF_TRUSTED_ORIGINS=https://atrue.onrender.com

# --- Email -------------------------------------------------------------------
# Defaults to the console backend for local development.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=webmaster@localhost
ATRUE_DEMO_PASSWORD=

# Brevo SMTP example (use your Brevo SMTP login and SMTP key, not your API key):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your_brevo_smtp_login
# EMAIL_HOST_PASSWORD=your_brevo_smtp_key
# DEFAULT_FROM_EMAIL=bookings@example.com
